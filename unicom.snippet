# 联通 CK 提取（Quantumult X 原生语法）v3 —— 真实接口版
#
# ── 接口依据 ──────────────────────────────────────────
# 本机 login-plugin-framework/plugins/unicom.login/manifest.json
# 真机实测的联通营业厅登录协议：
#   发码 POST https://m.client.10010.com/mobileService/sendRadomNum.htm
#   登录 POST https://m.client.10010.com/mobileService/radomLogin.htm
#   响应 JSON 里取 token_online / ecs_token
#
# ⚠️ 旧版脚本钩的 loginxhm.10010.com/mobileService/login_vcode_member.htm
#    是废弃接口（实测返回 {"code":"1","dsc":"...绑定关系失效..."}），
#    联通 App 不会请求它 —— 这就是「怎么配都没反应」的根因。
#
# ── 用法 ──────────────────────────────────────────────
# QX → 配置 → 引用资源 → + → 类型「重写」→ 填：
#   https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom.snippet
# 备用：
#   https://ghproxy.net/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom.snippet
#   https://ghfast.top/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom.snippet
#
# ── 触发条件 ──────────────────────────────────────────
# 脚本只在「联通 App 发起短信登录」那一刻触发。
# 已经在登录状态的话，必须【退出登录 → 重新用短信验证码登录】才会走这个接口。
#
# ── 前置条件 ──────────────────────────────────────────
# ① QX 设置 → MitM → 总开关打开
# ② 证书已生成并安装
# ③ 设置 → 通用 → 关于本机 → 证书信任设置 → 打开 QX 证书的「完全信任」
#    ← 装描述文件 ≠ 信任证书，这步最容易漏
# ④ 主配置 [mitm] 里最好再手动补一个 m.client.10010.com 做双保险

[rewrite_local]

# 请求阶段：抓 appId / deviceId（登录接口）
^https:\/\/m\.client\.10010\.com\/mobileService\/radomLogin\.htm url script-request-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom.js

# 请求阶段：抓 appId / deviceId（发码接口，兜底）
^https:\/\/m\.client\.10010\.com\/mobileService\/sendRadomNum\.htm url script-request-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom.js

# 响应阶段：解析 token_online / ecs_token
^https:\/\/m\.client\.10010\.com\/mobileService\/radomLogin\.htm url script-response-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom.js

[mitm]
hostname = %APPEND% m.client.10010.com
