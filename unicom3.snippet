# 联通凭证提取 v3 —— 通知按字段分条（Quantumult X 原生语法）
#
# ── 相对 v2 的改动 ────────────────────────────────────
# 1. 修掉「code=0000 被误报成失败」的 bug（0000 / 0 都算成功）
# 2. 通知按字段分条，标题直接写字段名，不再出现从中间截断的裸 hex
#    长字段会标明「第 i/n 段 / 第 X-Y 字符 / 共 N 字符」
# 3. 只弹 WANT 里列出的字段，其余短字段合并成一条
#
# ── 想改弹哪些字段 ────────────────────────────────────
# 脚本 unicom3.js 顶部有一行：
#   var WANT = ["token_online", "ecs_token", "t3_token"];
# 改成你需要的即可（可选：token_online / ecs_token / private_token /
# t3_token / appId / deviceId / deviceCode / desmobile / invalidat）
# 也可设 SHOW_EXTRA = false 关掉「其余字段」那条。
#
# 用本地脚本方式时改这里最方便：文件拷进 QX 的 Scripts 目录后直接编辑。
#
# ── 用法 ──────────────────────────────────────────────
# QX → 配置 → 引用资源 → + → 类型「重写」→ 填：
#   https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom3.snippet
#
# 前置：MitM 总开关打开 + 证书已安装且「完全信任」
# 触发：完全关掉联通 App 再从后台划掉，重新打开
#
# ── 真实接口（抓包实测）────────────────────────────────
#   POST https://loginxx.10010.com/mobileService/onLine.htm
#        响应 code:"0" 或 "0000" → token_online / ecs_token /
#        private_token / t3_token / appId / desmobile / invalidat
#   POST https://loginxx.10010.com/mobileService/login_vcode_member.htm
#        短信登录；成功返回 code:"0000" + member 列表（不含 token）
#
# ⚠️ 注意 host 是 loginxx，不是 loginxhm（原 3-in-1.js 写错的那个）

[rewrite_local]

# 请求阶段：抓 appId / deviceId / deviceCode
^https:\/\/loginxx\.10010\.com\/mobileService\/onLine\.htm url script-request-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom3.js

# 响应阶段：解析凭证（主规则）
^https:\/\/loginxx\.10010\.com\/mobileService\/onLine\.htm url script-response-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom3.js

# 备用：短信登录响应
^https:\/\/loginxx\.10010\.com\/mobileService\/login_vcode_member\.htm url script-response-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom3.js

[mitm]
hostname = %APPEND% loginxx.10010.com
