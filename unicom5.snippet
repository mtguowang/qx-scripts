# 联通凭证提取 v5 —— 去重 + 单条通知（Quantumult X 原生语法）
#
# ── 这一版解决什么 ────────────────────────────────────
# ① 弹 6 条的问题：同一个 token 在 20 秒内只处理一次。
#    你的日志里 17:20:21:068 和 17:20:21:125 是两遍一模一样的输出，
#    说明规则/引用资源被加载了两份，脚本对同一个响应跑了两遍。
#    去重能挡住重复，但【根因还是要清掉重复的资源】，见下面「务必检查」。
#
# ② 弹一条：默认整条 897 字符塞进一条通知。
#    ⚠️ iOS 通知正文只显示约 4 行（200 字符左右），超出部分打 … 截断。
#       这是系统限制，改脚本没用。完整值始终在 QX 日志里，不受长度限制。
#       想每条都看全：把 unicom5.js 里 PART 改成 180（会变成 5 条）。
#
# ── 务必检查：是不是加载了两份 ────────────────────────
# QX → 配置 → 引用资源：
#   · 看有没有两条同名的 unicom 资源，删掉多余那条
#   · 旧的 unicom.snippet / unicom2 / unicom3 / probe / debug / sniff 全部删除
# QX → 配置 → 编辑当前配置 → [rewrite_local]：
#   · 搜 "loginxx"，如果这里也有一份，说明本地配置里也写过，删掉
# 正常情况下 loginxx 相关的规则应该只有 3 条：
#   1 条 script-request-body + 2 条 script-response-body
#
# ── 真实接口（抓包实测）───────────────────────────────
#   POST https://loginxx.10010.com/mobileService/onLine.htm
#   POST https://loginxx.10010.com/mobileService/login_vcode_member.htm
# ⚠️ host 是 loginxx，不是 loginxhm
#
# ── 用法 ──────────────────────────────────────────────
# QX → 配置 → 引用资源 → + → 类型「重写」→ 填：
#   https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom5.snippet
# 触发：完全关掉联通 App（后台划掉），重新打开

[rewrite_local]

# 请求阶段：抓 appId / deviceId / deviceCode
^https:\/\/loginxx\.10010\.com\/mobileService\/onLine\.htm url script-request-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom5.js

# 响应阶段：拼 token_online#appId（主规则）
^https:\/\/loginxx\.10010\.com\/mobileService\/onLine\.htm url script-response-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom5.js

# 备用：短信登录响应
^https:\/\/loginxx\.10010\.com\/mobileService\/login_vcode_member\.htm url script-response-body https://gh-proxy.com/https://raw.githubusercontent.com/mtguowang/qx-scripts/main/unicom5.js

[mitm]
hostname = %APPEND% loginxx.10010.com
